<mah:MetroWindow  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" x:Class="Maintenance_request.Notification.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Width="380"
        Height="120"

        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
 BorderBrush="{x:Null}"      ResizeMode="NoResize" ShowTitleBar="False"   ShowInTaskbar="False"
        Topmost="True">


    <Border Background="White"
            CornerRadius="12"
            Padding="15"
            MouseLeftButtonUp="Border_Click">


        <Border.Effect>

            <DropShadowEffect
                BlurRadius="20"
                ShadowDepth="5"
                Opacity="0.3"/>

        </Border.Effect>


        <Grid>


            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="45"/>

                <ColumnDefinition/>

                <ColumnDefinition Width="25"/>

            </Grid.ColumnDefinitions>



            <Border Width="32"
                    Height="32"
                    CornerRadius="16"
                    Background="{Binding Color}">


                <TextBlock Text="!"
                           Foreground="White"
                           FontSize="20"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Border>




            <StackPanel Grid.Column="1"
                        Margin="10,0">


                <TextBlock Text="{Binding Title}"
                           FontWeight="Bold"
                           FontSize="15"/>



                <TextBlock Text="{Binding Message}"
                           Margin="0,8,0,0"
                           TextWrapping="Wrap"/>


            </StackPanel>




            <Button Grid.Column="2"
                    Content="×"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="18"
                    Click="Close_Click"/>


        </Grid>


    </Border>


</mah:MetroWindow>