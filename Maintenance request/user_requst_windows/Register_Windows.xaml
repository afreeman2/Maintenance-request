<mah:MetroWindow x:Class="Maintenance_request.user_requst_windows.Register_Windows"
                     xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" Title="تسجيل حساب مستخدم" Width="1000" Height="760" MinWidth="900" MinHeight="700"
    Language="ar-LY" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen"
     AllowsTransparency="True" Background="Transparent" ShowTitleBar="False" ShowCloseButton="False" WindowStyle="None" Loaded="Register_Windows_Loaded" dx:ThemeManager.ThemeName="Win11Light" BorderBrush="{x:Null}" 
                 Style="{x:Null}" BorderThickness="0" ResizeMode="NoResize">
    <mah:MetroWindow.Resources>
       
        <SolidColorBrush x:Key="Dmc.Blue" Color="#0152A4"/>
        <SolidColorBrush x:Key="Dmc.BlueSoft" Color="#EAF2FC"/>
        <SolidColorBrush x:Key="Dmc.Text" Color="#243447"/>
        <SolidColorBrush x:Key="Dmc.Muted" Color="#738195"/>
        <SolidColorBrush x:Key="Dmc.Border" Color="#DCE5EF"/>
        <SolidColorBrush x:Key="Dmc.FieldBackground" Color="#F8FAFC"/>
        <SolidColorBrush x:Key="Dmc.SectionBackground" Color="#F3F7FC"/>
        <SolidColorBrush x:Key="Dmc.Danger" Color="#B42318"/>
        <SolidColorBrush x:Key="Dmc.DangerBackground" Color="#FEF3F2"/>
        <FontFamily x:Key="Dmc.Font">Segoe UI</FontFamily>

        <Style x:Key="Dmc.WindowCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dmc.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="TextElement.FontFamily" Value="{StaticResource Dmc.Font}"/>
            <Setter Property="TextElement.Foreground" Value="{StaticResource Dmc.Text}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#142D4E" BlurRadius="18" ShadowDepth="3" Opacity="0.16"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Dmc.SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Dmc.SectionBackground}"/>
            <Setter Property="BorderBrush" Value="#E1E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="Dmc.FieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Dmc.Font}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource Dmc.Text}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Dmc.BaseButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource Dmc.Font}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Background" Value="{StaticResource Dmc.Blue}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="DmcButtonSurface" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DmcButtonSurface" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="DmcButtonSurface" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DmcButtonSurface" Property="BorderBrush" Value="#8EC5FF"/>
                                <Setter TargetName="DmcButtonSurface" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="DmcButtonSurface" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Dmc.PrimaryButton" TargetType="Button" BasedOn="{StaticResource Dmc.BaseButton}"/>
        <Style x:Key="Dmc.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Dmc.BaseButton}">
            <Setter Property="Background" Value="{StaticResource Dmc.BlueSoft}"/>
            <Setter Property="Foreground" Value="{StaticResource Dmc.Blue}"/>
        </Style>
        <Style x:Key="Dmc.DangerButton" TargetType="Button" BasedOn="{StaticResource Dmc.BaseButton}">
            <Setter Property="Background" Value="{StaticResource Dmc.DangerBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource Dmc.Danger}"/>
        </Style>
        <Style x:Key="Dmc.BaseInput" TargetType="{x:Type dxe:BaseEdit}">
            <Setter Property="FontFamily" Value="{StaticResource Dmc.Font}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="{StaticResource Dmc.FieldBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource Dmc.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dmc.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Dmc.TextInput" TargetType="{x:Type dxe:TextEdit}" BasedOn="{StaticResource Dmc.BaseInput}"/>
        <Style x:Key="Dmc.ComboInput" TargetType="{x:Type dxe:ComboBoxEdit}" BasedOn="{StaticResource Dmc.BaseInput}"/>
        <Style x:Key="Dmc.DateInput" TargetType="{x:Type dxe:DateEdit}" BasedOn="{StaticResource Dmc.BaseInput}"/>
        <Style x:Key="Dmc.PasswordInput" TargetType="{x:Type dxe:PasswordBoxEdit}" BasedOn="{StaticResource Dmc.BaseInput}"/>
        <!-- Grid editors share the row's selection surface; form inputs keep their own field surface. -->
        <Style x:Key="Dmc.GridCellText" TargetType="{x:Type dxe:TextEdit}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
        </Style>
        <Style x:Key="Dmc.ReadOnlyField" TargetType="Label">
            <Setter Property="Background" Value="{StaticResource Dmc.FieldBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource Dmc.Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Dmc.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource Dmc.Font}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Label">
                        <Border CornerRadius="9" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- الخطأ يظهر على الخانة عند محاولة الحفظ فقط ويزول فور تصحيحها. -->
        <ControlTemplate x:Key="Registration.Error">
            <Grid>
                <AdornedElementPlaceholder x:Name="field"/>
                <Border BorderBrush="#DC000C" BorderThickness="2" CornerRadius="6" IsHitTestVisible="False"/>
                <Border Background="#DC000C" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-7,-7,0,0">
                    <TextBlock Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Border.ToolTip>
                        <TextBlock Text="{Binding ElementName=field, Path=AdornedElement.(Validation.Errors)[0].ErrorContent}"/>
                    </Border.ToolTip>
                </Border>
            </Grid>
        </ControlTemplate>
        <Style x:Key="Registration.Input" TargetType="Control">
            <Setter Property="Height" Value="44"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#354A5A"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Registration.Error}"/>
            <Setter Property="Tag">
                <Setter.Value>
                    <Binding RelativeSource="{RelativeSource Self}" Path="Name" Mode="OneWay"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Registration.Surface" TargetType="Border">
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#B6C5CF"/>
            <Setter Property="Background" Value="#F6F8FA"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="#DEE8F0"/>
                    <Setter Property="BorderBrush" Value="#8FA8BB"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="icons:PackIconMaterial">
            <Setter Property="Width" Value="21"/>
            <Setter Property="Height" Value="21"/>
            <Setter Property="Foreground" Value="#547391"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style x:Key="Registration.Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#354A5A"/>
        </Style>
        <!-- رسالة الخطأ جزء من التخطيط وتظهر فور الحفظ، دون انتظار تحريك المؤشر فوق الخانة. -->
        <Style x:Key="Registration.ErrorText" TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Foreground" Value="#C40016"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,2,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag.(Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Setter Property="Text" Value="{Binding Tag.(Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </mah:MetroWindow.Resources>
    <!-- نافذة شفافة وبطاقة فاتحة مقروءة، بنفس هوية بقية شاشات التطبيق. -->
    <Border x:Name="RegistrationCard" Background="White" BorderBrush="#BDCAD5" BorderThickness="1" CornerRadius="14" Margin="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="#547391" CornerRadius="13,13,0,0">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>
                    <icons:PackIconMaterial Kind="AccountPlusOutline" Foreground="White" Width="27" Height="27"/>
                    <TextBlock Grid.Column="1" Text="تسجيل حساب مستخدم" Foreground="White" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/>
                    <dx:SimpleButton Grid.Column="2" Click="btnClose_Click" ToolTip="إغلاق" AutomationProperties.Name="إغلاق" Background="Transparent" BorderThickness="0" Width="36" Height="36">
                        <icons:PackIconMaterial Kind="Close" Foreground="White"/>
                    </dx:SimpleButton>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="26,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="48"/>
                </Grid.RowDefinitions>
                <TextBlock Foreground="#6B7F8E" Margin="0,0,0,16"><Run FlowDirection="RightToLeft" Language="ar-ly" Text="عدل بيانات الحساب"/></TextBlock>
                <Grid x:Name="FormPanel" Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="104"/>
                        <RowDefinition Height="104"/>
                        <RowDefinition Height="104"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="اسم المستخدم" Style="{StaticResource Registration.Label}"/>
                        <Border Style="{StaticResource Registration.Surface}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <icons:PackIconMaterial Kind="AccountOutline"/>
                                <TextBox x:Name="txtepm_name" Grid.Column="1" Style="{StaticResource Registration.Input}" MaxLength="100" TabIndex="1" TextChanged="Input_Changed" PreviewTextInput="Input_PreviewTextInput" PreviewKeyUp="Input_PreviewKeyUp"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="NameError" Tag="{Binding ElementName=txtepm_name}" Style="{StaticResource Registration.ErrorText}"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="كلمة المرور" Style="{StaticResource Registration.Label}"/>
                            <Border Style="{StaticResource Registration.Surface}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <icons:PackIconMaterial Kind="LockOutline"/>
                                    <PasswordBox x:Name="txb_new_Password" Grid.Column="1" Style="{StaticResource Registration.Input}" MaxLength="12" TabIndex="2" PasswordChanged="Input_Changed" PreviewTextInput="Input_PreviewTextInput" PreviewKeyUp="Input_PreviewKeyUp"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="PasswordError" Tag="{Binding ElementName=txb_new_Password}" Style="{StaticResource Registration.ErrorText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="تأكيد كلمة المرور" Style="{StaticResource Registration.Label}"/>
                            <Border Style="{StaticResource Registration.Surface}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <icons:PackIconMaterial Kind="LockCheckOutline"/>
                                    <PasswordBox x:Name="txb_sh_Password" Grid.Column="1" Style="{StaticResource Registration.Input}" MaxLength="12" TabIndex="3" PasswordChanged="Input_Changed" PreviewTextInput="Input_PreviewTextInput" PreviewKeyUp="Input_PreviewKeyUp"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="ConfirmationError" Tag="{Binding ElementName=txb_sh_Password}" Style="{StaticResource Registration.ErrorText}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="الإدارة التابع لها" Style="{StaticResource Registration.Label}"/>
                            <Border Style="{StaticResource Registration.Surface}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <icons:PackIconMaterial Kind="OfficeBuildingOutline"/>
                                    <ComboBox x:Name="cbomangment" Grid.Column="1" Style="{StaticResource Registration.Input}" TabIndex="4" ItemsSource="{Binding mang_list}" DisplayMemberPath="Mangment_Request" SelectedValuePath="Mangment_Request_ID" SelectionChanged="Input_Changed" PreviewKeyUp="Input_PreviewKeyUp"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="ManagementError" Tag="{Binding ElementName=cbomangment}" Style="{StaticResource Registration.ErrorText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="المبنى" Style="{StaticResource Registration.Label}"/>
                            <Border Style="{StaticResource Registration.Surface}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <icons:PackIconMaterial Kind="Domain"/>
                                    <ComboBox x:Name="_Combo_Bulding" Grid.Column="1" Style="{StaticResource Registration.Input}" TabIndex="5" ItemsSource="{Binding building_list}" DisplayMemberPath="Build" SelectedValuePath="Build_ID" SelectionChanged="Input_Changed" PreviewKeyUp="Input_PreviewKeyUp"/>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="BuildingError" Tag="{Binding ElementName=_Combo_Bulding}" Style="{StaticResource Registration.ErrorText}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <dx:WaitIndicator x:Name="LoadingIndicator" Content="جاري تنفيذ العملية..." DeferedVisibility="False" HorizontalAlignment="Right"/>
                    <Button x:Name="cancel" Click="btnCancel_Click" BorderBrush="Black" TabIndex="25" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" Width="122" Height="38" VerticalAlignment="Center" Background="{StaticResource Dmc.BlueSoft}" Margin="790,0,0,0" Style="{StaticResource Dmc.SecondaryButton}" Padding="6,0" Foreground="{StaticResource Dmc.Blue}" BorderThickness="0">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                            <iconPacks:PackIconBootstrapIcons Kind="XCircleFill" Margin="0,0,7,0" Width="18" Height="18" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock FontSize="12" VerticalAlignment="Center" Text="إلغاء الأمر" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <dx:SimpleButton x:Name="save_User" Click="save_User_Click" IsEnabled="False" TabIndex="6" Height="42" Padding="18,4" Background="#547391" Foreground="White" BorderBrush="#547391" Margin="320,3,216,3">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconMaterial Kind="ContentSaveOutline" Foreground="White" Margin="0,0,8,0"/>
                            <TextBlock Text="تسجيل المستخدم" VerticalAlignment="Center"/>
                        </StackPanel>
                    </dx:SimpleButton>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</mah:MetroWindow>
