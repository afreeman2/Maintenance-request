<mah:MetroWindow xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Maintenance_request.user_requst_windows.Request_Window"
              BorderThickness="0" BorderBrush="{x:Null}"   Title="طلب صيانة جديد" dx:ThemeManager.ThemeName="Win11Light" Width="900" Height="562"  WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" WindowStyle="None" ShowTitleBar="False" ShowCloseButton="False" ShowMinButton="False" ShowMaxRestoreButton="False" WindowButtonCommandsOverlayBehavior="Never" Language="ar-LY" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="15" Loaded="Request_Window_Loaded" WindowState="Normal" ResizeMode="CanResize">

    <Border Margin="6" CornerRadius="18" Background="{StaticResource Client.Canvas}" BorderBrush="{StaticResource Client.Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Client.Header}" CornerRadius="18,18,0,0" Padding="24,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="btnCancel_Click"  FontSize="25" Width="44" Style="{StaticResource Client.Button}" Background="Transparent" Padding="0">
                        <Path Width="16" Height="16" Stretch="Uniform" Data="M0,0 L16,16 M16,0 L0,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <icons:PackIconMaterial Kind="ClipboardEditOutline" Foreground="#E2C58E" Width="28" Height="28" Margin="0,0,12,0"/>
                        <TextBlock Text="طلب صيانة جديد" Foreground="White" FontSize="25" FontWeight="SemiBold"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="2" Background="White" CornerRadius="0,0,18,18" Padding="26,16" BorderBrush="{StaticResource Client.Line}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <dx:WaitIndicator x:Name="LoadingIndicator" DeferedVisibility="False" Margin="12,0"/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1">
                        <Button x:Name="save_Request" Click="save_Request_Click" Style="{StaticResource Client.Button}" MinWidth="160">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconMaterial Kind="SendOutline" Width="21" Height="21" Margin="0,0,8,0"/>
                                <TextBlock Text="إرسال الطلب"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Border>
            <Grid MaxWidth="1000" Margin="30,4,44,7" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="1" Style="{StaticResource Client.Card}" Padding="26">
                    <StackPanel x:Name="FormPanel">
                        <TextBlock Style="{StaticResource Client.Label}" Text="نوع الصيانة"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <icons:PackIconMaterial Kind="Tools" Foreground="{StaticResource Client.Blue}" Width="22" Height="22" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1" x:Name="_Combo_Types" Style="{StaticResource Client.Input}" DisplayMemberPath="Serv_type" SelectedValuePath="Serv_num" IsTextSearchEnabled="True" PreviewKeyUp="_Combo_Types_PreviewKeyUp"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Client.ErrorText}" Tag="{Binding ElementName=_Combo_Types}"/>
                        <TextBlock Style="{StaticResource Client.Label}" Text="تفاصيل طلب الصيانة" Margin="0,24,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <icons:PackIconMaterial Kind="TextBoxOutline" Foreground="{StaticResource Client.Blue}" Width="22" Height="22" VerticalAlignment="Top" Margin="0,12,0,0"/>
                            <TextBox Grid.Column="1" x:Name="TxtName" Style="{StaticResource Client.Input}" MinHeight="145" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Client.ErrorText}" Tag="{Binding ElementName=TxtName}"/>
                        <Border Background="#F6F0E5" CornerRadius="10" Padding="14" Margin="0,22,0,0">
                            <TextBlock Text="يمكنك تعديل الطلب أو إلغاؤه حتى إصدار تكليف الصيانة. ستصلك ردود القسم المختص تلقائيًا." Foreground="#83663E" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</mah:MetroWindow>