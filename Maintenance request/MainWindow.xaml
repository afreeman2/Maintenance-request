<mah:MetroWindow x:Class="Maintenance_request.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm" xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:tb="http://www.hardcodet.net/taskbar" xmlns:local1="clr-namespace:Maintenance_request.converts" xmlns:support="clr-namespace:Maintenance_request.Support"
                 dx:ThemeManager.ThemeName="Win11Light" Icon="/Maintenance request;component/Resources/maintenance-request-bell.ico" 
                 DataContext="{dxmvvm:ViewModelSource 
    Type={x:Type local1:NotificationMainViewModel}}" 
                 Title="تطبيق طلبات الصيانة" Width="1280" Height="800" MinWidth="1000"
                 MinHeight="660" WindowStartupLocation="CenterScreen" WindowStyle="None"
                 AllowsTransparency="True" Background="Transparent" BorderBrush="{x:Null}" 
                 BorderThickness="0" ShowTitleBar="False" ShowCloseButton="False" ShowMinButton="False"
                 ShowMaxRestoreButton="False" WindowButtonCommandsOverlayBehavior="Never" GlowBrush="{x:Null}"
                 Loaded="MetroWindow_Loaded" Closed="MetroWindow_Closed" StateChanged="MetroWindow_StateChanged"
                 FontFamily="Segoe UI" FontSize="14" Language="ar-LY" FlowDirection="RightToLeft"
                 ResizeMode="CanResize">
 <mah:MetroWindow.Resources><ResourceDictionary>
         <Style x:Key="Request.ToastStyle" TargetType="ContentControl">
            <Setter Property="Width" Value="350"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
        </Style>
        <DataTemplate x:Key="Request.Toast">
            <Border Width="350" Background="{Binding TintColor}" BorderBrush="{Binding AccentColor}" BorderThickness="1" CornerRadius="10" Padding="12" FlowDirection="RightToLeft" dx:ThemeManager.ThemeName="Win11Light">
                <StackPanel>
                    <DockPanel><iconPacks:PackIconMaterial Kind="BellRingOutline" Width="19" Height="19" Foreground="{Binding AccentColor}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Title}" Foreground="{Binding AccentColor}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </DockPanel>
                    <TextBlock Text="{Binding Text}" FontSize="13" Foreground="#354A5A" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    <TextBlock Text="اضغط لعرض طلبات الصيانة" Foreground="{Binding AccentColor}" FontSize="12" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </DataTemplate>


 <BooleanToVisibilityConverter x:Key="Request.Visibility"/>
 <Style x:Key="Request.CardItem" TargetType="ListBoxItem">
  <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  <Setter Property="Margin" Value="0,0,0,7"/>
  <Setter Property="Template">
   <Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="CardSurface" Background="{Binding TintColor}" BorderBrush="{Binding AccentColor}"
            BorderThickness="1" CornerRadius="10">
     <ContentPresenter HorizontalAlignment="Stretch"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True">
      <Setter TargetName="CardSurface" Property="Background" Value="#FFFFFF"/>
      <Setter TargetName="CardSurface" Property="BorderThickness" Value="2"/>
     </Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CardSurface" Property="BorderThickness" Value="2"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value>
  </Setter>
 </Style>
 </ResourceDictionary></mah:MetroWindow.Resources>
 <mah:MetroWindow.Flyouts><mah:FlyoutsControl>
  <!-- تمتد حاوية اللوحة على مساحة النافذة لتتوسط بطاقة الحساب أفقيًا ورأسيًا. -->
  <mah:Flyout x:Name="AccountFlyout" Position="Bottom" VerticalAlignment="Stretch" AreAnimationsEnabled="False"
              Background="Transparent" HeaderTemplate="{StaticResource Client.FlyoutHeader}"
              CloseButtonVisibility="Collapsed" Padding="0"
              IsModal="True" AnimateOpacity="True">
   <Grid Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}">
   <!-- قالب MahApps يحجز 20 وحدة للرأس المطوي؛ نوازنها من الجهة المقابلة في RTL. -->
   <Border x:Name="AccountCard" Style="{StaticResource Client.Card}" MaxWidth="760" VerticalAlignment="Center" Margin="20,20,40,20" Padding="0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Border Background="{StaticResource Client.Header}" CornerRadius="16,16,0,0" Padding="22,15"><DockPanel><Button DockPanel.Dock="Right" Click="CloseAccount_Click" Style="{StaticResource Client.Secondary}" Width="40" Padding="0"><Path Width="16" Height="16" Stretch="Uniform" Data="M0,0 L16,16 M16,0 L0,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button><TextBlock Text="حسابي وتفضيلات التنبيه" Foreground="White" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel></Border>
     <StackPanel Grid.Row="1" Margin="26">
      <TextBlock x:Name="AccountDetails" Foreground="{StaticResource Client.Muted}" Margin="0,0,0,12"/>
      <TextBlock Text="اسم المستخدم" Style="{StaticResource Client.Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><iconPacks:PackIconMaterial Kind="AccountOutline" Width="20" Height="20" Foreground="{StaticResource Client.Blue}" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="AccountName" Style="{StaticResource Client.Input}"/></Grid><TextBlock Style="{StaticResource Client.ErrorText}" Tag="{Binding ElementName=AccountName}"/>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="الإدارة التابع لها" Style="{StaticResource Client.Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><iconPacks:PackIconMaterial Kind="OfficeBuildingOutline" Width="20" Height="20" Foreground="{StaticResource Client.Blue}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="AccountManagement" Style="{StaticResource Client.Input}" DisplayMemberPath="Mangment_Request" SelectedValuePath="Mangment_Request_ID"/></Grid><TextBlock Style="{StaticResource Client.ErrorText}" Tag="{Binding ElementName=AccountManagement}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="المبنى" Style="{StaticResource Client.Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><iconPacks:PackIconMaterial Kind="OfficeBuilding" Width="20" Height="20" Foreground="{StaticResource Client.Blue}" VerticalAlignment="Center"/><ComboBox Grid.Column="1" x:Name="AccountBuilding" Style="{StaticResource Client.Input}" DisplayMemberPath="Build" SelectedValuePath="Build_ID"/></Grid><TextBlock Style="{StaticResource Client.ErrorText}" Tag="{Binding ElementName=AccountBuilding}"/></StackPanel></Grid>
      <CheckBox x:Name="SoundEnabled" Content="تشغيل صوت إشعارات طلبات الصيانة" Margin="0,20,0,12"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="SoundChoice" SelectedValuePath="Value" ItemsSource="{x:Static support:ClientChoices.Sounds}" Style="{StaticResource Client.Input}"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0"/><TextBlock Text="{Binding Title}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Click="PreviewSound_Click" Style="{StaticResource Client.Secondary}" Margin="10,0,0,0"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="VolumeHigh" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="استماع"/></StackPanel></Button></Grid>
      <Button x:Name="SavePreferencesButton" Click="SavePreferences_Click" Style="{StaticResource Client.Button}" HorizontalAlignment="Left" MinWidth="160" Margin="0,22,0,0"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ContentSaveOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="حفظ بيانات الحساب"/></StackPanel></Button>
     </StackPanel>
    </Grid>
   </Border>
   </Grid>
  </mah:Flyout>
 </mah:FlyoutsControl></mah:MetroWindow.Flyouts>
 <!-- إطار خارجي شفاف، وتحتفظ البطاقات والترويسة بخلفياتها الخاصة. -->
 <Border Margin="6" CornerRadius="18" Background="White" BorderThickness="0">
 <Grid><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>
  <tb:TaskbarIcon x:Name="MyNotifyIcon" IconSource="/Maintenance request;component/Resources/maintenance-request-bell.ico" ToolTipText="تطبيق طلبات الصيانة" TrayMouseDoubleClick="MyNotifyIcon_TrayMouseDoubleClick"><tb:TaskbarIcon.ContextMenu><ContextMenu FlowDirection="RightToLeft"><MenuItem Header="فتح التطبيق" Click="Open_Click"/><MenuItem Header="إغلاق التطبيق" Click="Exit_Click"/></ContextMenu></tb:TaskbarIcon.ContextMenu></tb:TaskbarIcon>
  <Border Background="{StaticResource Client.Header}" CornerRadius="18,18,0,0" Padding="20,0">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" MouseLeftButtonDown="Title_MouseDown"><Border Background="White" CornerRadius="12" Width="46" Height="46" Margin="0,0,12,0"><Image Source="/Resources/ssf Logo.png" Margin="5" Stretch="Uniform"/></Border><StackPanel><TextBlock Text="طلبات الصيانة" Foreground="White" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="صندوق الضمان الاجتماعي" Foreground="#D7E1ED" FontSize="12"/></StackPanel></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="nofig" Click="nofig_Click" Style="{StaticResource Client.Button}" Background="#6685A5" Width="48" Margin="0,0,10,0" ToolTip="طلباتي وإشعاراتي" Padding="0"><dx:Badge.Badge><dx:Badge x:Name="bg1" Content="0" Visibility="Collapsed" Background="#C4A15E" Foreground="#1C3048"/></dx:Badge.Badge><iconPacks:PackIconMaterial Kind="BellOutline" Width="23" Height="23"/></Button>
     <Button Click="btnman_Click" Style="{StaticResource Client.Button}" Background="Transparent" ToolTip="تصغير إلى شريط النظام" Content="−" Width="42" FontSize="24" Padding="0"/>
     <Button Click="btnCancel_Click" Style="{StaticResource Client.Button}" Background="Transparent" ToolTip="إغلاق التطبيق" Width="42" Padding="0"><Path Width="16" Height="16" Stretch="Uniform" Data="M0,0 L16,16 M16,0 L0,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Button>
    </StackPanel>
   </Grid>
  </Border>
  <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource Client.Line}" BorderThickness="0,0,0,1" Padding="20,8"><WrapPanel>
   <Button Click="Request_mnue_Click" Style="{StaticResource Client.Secondary}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="PlusCircleOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="طلب جديد   F5"/></StackPanel></Button>
   <Button Click="nofig_Click" Style="{StaticResource Client.Secondary}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="ClipboardTextOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="متابعة طلباتي   F6"/></StackPanel></Button>
   <Button Click="opt_Click" Style="{StaticResource Client.Secondary}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="AccountCircleOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="حسابي   F8"/></StackPanel></Button>
   <Button Click="ch_password_mnue_Click" Style="{StaticResource Client.Secondary}"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="LockOutline" Width="20" Height="20" Margin="0,0,8,0"/><TextBlock Text="كلمة المرور   F9"/></StackPanel></Button>
  </WrapPanel></Border>
  <Grid x:Name="Dashboard" Grid.Row="2" Margin="26,18"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="{StaticResource Client.Header}" CornerRadius="18" Padding="28" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="WelcomeText" Text="تطبيق طلبات الصيانة" Foreground="#E7D2A9" FontSize="16"/>
                            <TextBlock Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,10,0,10"><Run FlowDirection="RightToLeft" Language="ar-ly" Text="ارسال طلبات الصيانة"/></TextBlock>
                            <TextBlock Foreground="#D7E3EF" FontSize="16" TextWrapping="Wrap"><Run FlowDirection="RightToLeft" Language="ar-ly" Text="ارسل ⮜ طلب الصيانة 📝 وتابع 👁️ اشعارات 🔔 وحالة الطلب مع القسم المختص"/></TextBlock>
                            <Button x:Name="NewRequestButton" Click="Request_mnue_Click" Style="{StaticResource Client.Button}" Background="#C1A16A" Foreground="#1E334C" HorizontalAlignment="Left" Margin="0,24,0,0"><StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="SendOutline" Width="22" Height="22" Margin="0,0,10,0"/><TextBlock Text="إرسال طلب صيانة"/></StackPanel></Button>
    </StackPanel>
    <Viewbox Grid.Column="1" StretchDirection="DownOnly" Margin="28,0,0,0"><Canvas Width="360" Height="250"><Ellipse Width="230" Height="230" Canvas.Left="65" Canvas.Top="12" Stroke="#526F91" Fill="#15345478"/><Ellipse Width="180" Height="180" Canvas.Left="90" Canvas.Top="37" Stroke="#365373"/><Border Canvas.Left="104" Canvas.Top="39" Width="145" Height="170" Background="#F4F7FC" BorderBrush="#9CB6D1" BorderThickness="1" CornerRadius="16"/><Border Canvas.Left="140" Canvas.Top="26" Width="74" Height="24" Background="#C1A16A" CornerRadius="8"/><Path Data="M128,80 H226 M128,106 H226 M128,132 H183 M128,158 H173" Stroke="#ADBED3" StrokeThickness="4" StrokeStartLineCap="Round"/><Border Canvas.Left="207" Canvas.Top="145" Width="70" Height="70" CornerRadius="22" Background="#C1A16A"><iconPacks:PackIconMaterial Kind="WrenchOutline" Width="36" Height="36" Foreground="#213D5A" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Path Data="M40,220 H326 M55,231 H310" Stroke="#718CAA" StrokeThickness="2"/></Canvas></Viewbox>
   </Grid></Border>
   <Border Grid.Row="1" Style="{StaticResource Client.Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><TextBlock Text="السنة" Foreground="{StaticResource Client.Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><dxe:SpinEdit x:Name="StatsYear" Width="105" Height="32" MinValue="1900" MaxValue="2200" IsFloatValue="False" AllowNullInput="True" EditValueChanged="StatsYear_Changed" ToolTip="امسح السنة لعرض جميع السنوات"/></StackPanel><TextBlock Text="نظرة على طلباتك" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Client.Ink}" VerticalAlignment="Center"/></DockPanel>
    <UniformGrid Grid.Row="1" Columns="4">
     <Border Background="#EDF2F8" CornerRadius="10" Padding="16,10" Margin="4,0"><StackPanel><TextBlock Text="إجمالي الطلبات" Foreground="#536F8C"/><TextBlock x:Name="TotalCountText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="#233B54"/></StackPanel></Border>
     <Border Background="#E9F0FB" CornerRadius="10" Padding="16,10" Margin="4,0"><StackPanel><TextBlock Text="بانتظار التكليف" Foreground="#355F9A"/><TextBlock x:Name="NewCountText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="#355F9A"/></StackPanel></Border>
     <Border Background="#FBF2E3" CornerRadius="10" Padding="16,10" Margin="4,0"><StackPanel><TextBlock Text="جاري التنفيذ" Foreground="#916424"/><TextBlock x:Name="InProgressCountText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="#916424"/></StackPanel></Border>
     <Border Background="#EEEBF8" CornerRadius="10" Padding="16,10" Margin="4,0"><StackPanel><TextBlock Text="تم التنفيذ" Foreground="#66518E"/><TextBlock x:Name="CompletedCountText" Text="0" FontSize="30" FontWeight="SemiBold" Foreground="#66518E"/></StackPanel></Border>
    </UniformGrid>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="3" Background="#E5ECF4" CornerRadius="0,0,18,18" Padding="20,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="lus" Foreground="{StaticResource Client.Ink}"/><TextBlock x:Name="RefreshStatus" Text="متابعة الطلبات متوقفة" Foreground="{StaticResource Client.Muted}" Margin="20,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight"><TextBlock x:Name="LDATE"/><TextBlock x:Name="ltim" Margin="12,0"/><TextBlock x:Name="vesion" Foreground="{StaticResource Client.Muted}"/></StackPanel></Grid></Border>
  <!-- مركز الطلبات مرتبط بالجرس؛ النصوص والألوان والعمليات الأصلية محفوظة. -->
  <Border x:Name="RequestsAnchor" Grid.Row="0" Height="1"
          Width="{Binding Width, ElementName=RequestsPanel}"
          HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False"/>
  <dxe:FlyoutControl x:Name="Notifi_Show" Grid.RowSpan="4"
                     PlacementTarget="{Binding ElementName=RequestsAnchor}"
                     StaysOpen="False" AllowOutOfScreen="False" VerticalOffset="8"
                     AllowMoveAnimation="False" AnimationDuration="0:0:0"
                     Background="Transparent" BorderThickness="0" Padding="0">
   <dxe:FlyoutControl.Settings>
    <dxe:FlyoutSettings Placement="Bottom" ShowIndicator="False"/>
   </dxe:FlyoutControl.Settings>

   <Border x:Name="RequestsPanel" Style="{StaticResource Client.Card}" Width="760" Height="520"
           Padding="16" Background="#F3F6FB" FlowDirection="RightToLeft" dx:ThemeManager.ThemeName="Win11Light">
    <Grid>
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>
     <DockPanel>
      <Button DockPanel.Dock="Right" Click="Notifi_Hid_Click" Style="{StaticResource Client.Secondary}"
              Width="38" Padding="0" AutomationProperties.Name="إغلاق مركز الإشعارات">
       <iconPacks:PackIconMaterial Kind="Close" Width="18" Height="18"/>
      </Button>
      <StackPanel>
       <StackPanel Orientation="Horizontal">
        <iconPacks:PackIconMaterial Kind="BellBadgeOutline" Width="25" Height="25" Foreground="{StaticResource Client.Blue}" Margin="0,0,9,0"/>
        <TextBlock Text="مركز الإشعارات" FontSize="23" FontWeight="SemiBold" Foreground="{StaticResource Client.Ink}"/>
       </StackPanel>
       <TextBlock Text="متابعة حالة طلبات الصيانة الخاصة بك" Foreground="{StaticResource Client.Muted}" Margin="0,3,0,0"/>
      </StackPanel>
     </DockPanel>
     <UniformGrid Grid.Row="1" Columns="4" Margin="0,11,0,8">
      <Border Background="#29445F" CornerRadius="9" Padding="10,5" Margin="0,0,4,0"><StackPanel><TextBlock Text="الإجمالي" Foreground="#DCE8F4"/><TextBlock x:Name="NoticeTotal" Foreground="White" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Background="#E8EFF9" CornerRadius="9" Padding="10,5" Margin="2,0"><StackPanel><TextBlock Text="بانتظار التكليف" Foreground="#3559A0"/><TextBlock x:Name="NoticeWaiting" Foreground="#3559A0" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Background="#E2F4F5" CornerRadius="9" Padding="10,5" Margin="2,0"><StackPanel><TextBlock Text="جاري التنفيذ" Foreground="#08717D"/><TextBlock x:Name="NoticeExecuting" Foreground="#08717D" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
      <Border Background="#E8F5EE" CornerRadius="9" Padding="10,5" Margin="4,0,0,0"><StackPanel><TextBlock Text="تم التنفيذ" Foreground="#26735C"/><TextBlock x:Name="NoticeCompleted" Foreground="#26735C" FontSize="22" FontWeight="SemiBold"/></StackPanel></Border>
     </UniformGrid>
     <Grid Grid.Row="2" Margin="0,0,0,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="175"/></Grid.ColumnDefinitions>
      <DockPanel Margin="0,0,8,0">
       <iconPacks:PackIconMaterial Kind="Magnify" Width="19" Height="19" Foreground="{StaticResource Client.Blue}" Margin="0,0,8,0"/>
       <TextBox x:Name="NoticeSearch" Style="{StaticResource Client.Input}" MinHeight="36" TextChanged="NoticeSearch_Changed"
                mah:TextBoxHelper.Watermark="ابحث في الوصف أو المبنى أو نوع الصيانة" AutomationProperties.Name="بحث الإشعارات"/>
      </DockPanel>
      <ComboBox x:Name="NoticeFilter" Grid.Column="1" Style="{StaticResource Client.Input}" MinHeight="36"
                SelectionChanged="NoticeFilter_Changed" AutomationProperties.Name="تصفية الإشعارات">
       <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
        <iconPacks:PackIconMaterial Kind="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0"/>
        <TextBlock Text="{Binding Title}"/>
       </StackPanel></DataTemplate></ComboBox.ItemTemplate>
      </ComboBox>
     </Grid>
     <DockPanel Grid.Row="3" Margin="0,0,0,6">
      <Button Click="Poke_click" Style="{StaticResource Client.Secondary}" MinHeight="34" Padding="10,4">
       <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="Refresh" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="تحديث"/></StackPanel>
      </Button>
      <Button Click="ReadAllNotices_Click" Style="{StaticResource Client.Secondary}" MinHeight="34" Padding="10,4" Margin="6,0">
       <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="CheckAll" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="تعيين الكل كمقروء"/></StackPanel>
      </Button>
      <TextBlock x:Name="NoticeResults" Foreground="{StaticResource Client.Muted}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
     </DockPanel>
     <Grid Grid.Row="4">
      <ListBox x:Name="NoticeList" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Request.CardItem}"
               SelectionChanged="NoticeList_SelectionChanged" MouseDoubleClick="NoticeList_DoubleClick"
               PreviewKeyDown="NoticeList_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
       <ListBox.GroupStyle><GroupStyle><GroupStyle.HeaderTemplate><DataTemplate>
        <DockPanel Margin="0,2,0,5">
         <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" Foreground="{StaticResource Client.Muted}"/>
         <TextBlock Text="{Binding Name}" Foreground="{StaticResource Client.Blue}" FontWeight="SemiBold"/>
        </DockPanel>
       </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListBox.GroupStyle>
       <ListBox.ItemTemplate><DataTemplate>
        <Grid Margin="10,7"><Grid.ColumnDefinitions><ColumnDefinition Width="5"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Background="{Binding AccentColor}" CornerRadius="2"/>
         <StackPanel Grid.Column="1" Margin="8,0">
          <TextBlock Text="{Binding Title}" Foreground="{Binding AccentColor}" FontSize="15" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Row.Description}" Foreground="{StaticResource Client.Ink}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
          <TextBlock Text="{Binding Context}" Foreground="{StaticResource Client.Muted}" TextTrimming="CharacterEllipsis" FontSize="12"/>
         </StackPanel>
         <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <Border Background="White" CornerRadius="5" Padding="5,2" HorizontalAlignment="Left"
                  Visibility="{Binding IsUnread, Converter={StaticResource Request.Visibility}}"><TextBlock Text="جديد" Foreground="{Binding AccentColor}" FontSize="11"/></Border>
          <TextBlock Text="{Binding DateLabel}" Foreground="{StaticResource Client.Muted}" FontSize="11" FlowDirection="LeftToRight"/>
          <TextBlock Text="{Binding WaitingLabel}" Foreground="#896226" FontSize="11"/>
         </StackPanel>
        </Grid>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="EmptyRequestsText" Text="لا توجد إشعارات مطابقة" Foreground="{StaticResource Client.Muted}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
     </Grid>
     <Border x:Name="NoticeDetails" Grid.Row="5" Background="White" BorderBrush="{StaticResource Client.Line}"
             BorderThickness="1" CornerRadius="9" Padding="9" Margin="0,6,0,0" Visibility="Collapsed">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Margin="0,0,8,0">
        <TextBlock Text="{Binding Title}" Foreground="{Binding AccentColor}" FontWeight="SemiBold"/>
        <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto">
         <TextBlock Text="{Binding Row.Description}" TextWrapping="Wrap" Foreground="{StaticResource Client.Ink}"/>
        </ScrollViewer>
        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Client.Muted}"/>
       </StackPanel>
       <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <Button x:Name="EditNoticeRequest" Click="EditNoticeRequest_Click" Style="{StaticResource Client.Button}" MinHeight="34" Padding="10,4">
         <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="PencilOutline" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="عرض وتعديل الطلب"/></StackPanel>
        </Button>
        <Button x:Name="DismissNotice" Tag="{Binding Row}" Click="DismissCompletedNotification_Click" Style="{StaticResource Client.Secondary}" MinHeight="34" Padding="10,4">
         <StackPanel Orientation="Horizontal"><iconPacks:PackIconMaterial Kind="DeleteOutline" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="حذف الإشعار"/></StackPanel>
        </Button>
       </StackPanel>
      </Grid>
     </Border>
     <TextBlock Grid.Row="6" Text="{Binding Text, ElementName=RefreshStatus}" Foreground="{StaticResource Client.Muted}" FontSize="12" Margin="0,5,0,0"/>
    </Grid>
   </Border>
  </dxe:FlyoutControl>
 </Grid></Border>
</mah:MetroWindow>
