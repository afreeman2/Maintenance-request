                <Button x:Name="btnCancel"  Click="btnCancel_Click"  Visibility="Visible" Height="31" Width="33" FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{x:Null}" BorderThickness="0" Background="{x:Null}" Margin="666,2,0,0" ToolTip="إغلاق النافذة">
