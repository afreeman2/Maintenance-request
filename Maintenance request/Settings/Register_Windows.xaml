                        SelectedValuePath="Build_ID" Foreground="#FF54473D" Background="{x:Null}" BorderBrush="{x:Null}" Margin="-0.8,-0.8,-1.2,-1.2" Padding="10"/>
                </Border>
                <TextBlock Width="146" VerticalAlignment="Top" TextWrapping="Wrap" Margin="288,178,0,0" Height="21" HorizontalAlignment="Left" FontFamily="Segoe UI" Foreground="#FF3C3C3C" FontSize="10.667"><Run FlowDirection="RightToLeft" Text="المبني"/></TextBlock>
                <Border BorderThickness="1" Margin="5,2,0,0" Height="33" VerticalAlignment="Top" HorizontalAlignment="Left" Width="334" Background="{StaticResource PrimaryThemeBrush}" >
                    <Grid>
                        <TextBlock HorizontalAlignment="Left" Foreground="White" Margin="47,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" Height="21" Width="148" FontFamily="Segoe UI" FontSize="13.333" FontWeight="Bold" Text="تسجيل حساب مستخدم"/>
                        <Custom:PackIconBootstrapIcons Kind="PersonBoundingBox" Foreground="White" OpacityMask="WhiteSmoke" Height="30" Width="29" Margin="4,0,0,0" />
