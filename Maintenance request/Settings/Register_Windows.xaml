        <Button Style="{StaticResource ButtonStyle1}" x:Name="cancel_subwindows" Click="btnClose_Click"  BorderBrush="Black" TabIndex="36"  FontFamily="Segoe UI" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left" Width="122" Height="38" VerticalAlignment="Top" Background="{StaticResource PrimaryThemeBrush}" Margin="559,327,0,0" >
            <StackPanel Width="118" Height="38">
                <!--<Image x:Name="im" Source="bin/x64/Debug/Images/document-check-icon.png"  Margin="29,-1,-47.6,0.8" HorizontalAlignment="Left" Width="37" />-->
