                <Label VerticalContentAlignment="Center" Content="حفظ البيانات&#xA;" Style="{StaticResource mybl}"  Margin="1,-23,0,-0.2" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" Width="81" Foreground="White" Height="29"/>
                <Separator IsTabStop="False" Height="22" Background="#FFB1AEAE" Margin="50,-31,14.4,-5.2" RenderTransformOrigin="0.5,0.5" Width="24">
                    <Separator.RenderTransform>
