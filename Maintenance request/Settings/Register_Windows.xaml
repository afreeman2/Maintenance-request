                <TextBlock  Text="*" FontFamily="Segoe UI" Margin="415,171,0,0" Foreground="Red" Height="21" VerticalAlignment="Top" RenderTransformOrigin="0.361,2.333" HorizontalAlignment="Left" Width="6" FontWeight="Bold" FontSize="13.333"/>
                <Border BorderBrush="#FFD6D4D4" BorderThickness="1"  Background="White" Height="42" VerticalAlignment="Top" Margin="353,197,0,0" HorizontalAlignment="Left" Width="311">
                    <TextBox x:Name="txbUsername" TabIndex="6" BorderThickness="1" BorderBrush="{x:Null}" FontFamily="Segoe UI" FontWeight="SemiBold" Padding="8,4,0,0" Foreground="#FF4E5F68" Background="{x:Null}" Height="42" VerticalAlignment="Top"
        	            Text="{Binding User.Username}" HorizontalAlignment="Left" Width="311" Margin="-1"/>
                </Border>-->

