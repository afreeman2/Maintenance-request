                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag"  Mode="TwoWay" UpdateSourceTrigger="Explicit" NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True" >
                                <Binding.ValidationRules>
