                <Label VerticalContentAlignment="Center" Content="إلـغـاء الأمــر" Style="{StaticResource mybl}"  Margin="6,-27,0,-0.2" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left" Width="81" Foreground="White" Height="29"/>
