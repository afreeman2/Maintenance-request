                <Border BorderBrush="#FFD6D4D4" BorderThickness="1"  Background="White" Height="42" VerticalAlignment="Top" Margin="493,123,0,0" HorizontalAlignment="Left" Width="200">
                    <PasswordBox PasswordChanged="txb_sh_Password_PasswordChanged" x:Name="txb_sh_Password" mah:PasswordBoxHelper.CapsLockWarningToolTip="زر Caps Lock مفعل"  BorderThickness="1" BorderBrush="#FFD6D4D4"  VerticalAlignment="Top" TabIndex="3" Padding="8" Height="41" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="#FF2A2E30" Background="{x:Null}" HorizontalAlignment="Left" Width="199" Margin="0.2,0.2,-1.2,-1.2" mah:TextBoxHelper.WatermarkAlignment="Center" mah:TextBoxHelper.Watermark="أدخل كلمة تأكيد المرور"
                    mah:TextBoxHelper.ClearTextButton="{Binding (mah:TextBoxHelper.HasText), Mode=OneWay, RelativeSource={RelativeSource self}}" mah:TextBoxHelper.IsWaitingForData="True" Style="{DynamicResource MahApps.Styles.PasswordBox.Win8}"
                    mah:TextBoxHelper.UseFloatingWatermark="False" FontSize="11.3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                        <PasswordBox.Tag>
                            <Binding RelativeSource="{RelativeSource Self}" Path="Tag"  Mode="TwoWay" UpdateSourceTrigger="Explicit" NotifyOnValidationError="True" ValidatesOnDataErrors="True" ValidatesOnExceptions="True" ValidatesOnNotifyDataErrors="True" >
                                <Binding.ValidationRules>
                                    <local1:ErrorRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </PasswordBox.Tag>

                    </PasswordBox>

                </Border>

                <Border BorderBrush="#FF547391" BorderThickness="0,0,0,0.8" Margin="38,0,38.4,90.2" Height="8" VerticalAlignment="Bottom" />
                <!--<Border BorderBrush="#FFD6D4D4" BorderThickness="1"  Background="White" Height="42" VerticalAlignment="Top" HorizontalAlignment="Left" Width="195" Margin="38,206,0,0">
                    <ComboBox x:Name="cboAdjective" TabIndex="5"  HorizontalAlignment="Left" VerticalAlignment="Top" Width="195" Height="42" FontFamily="Segoe UI" FontSize="11.333"
                  
                        Foreground="#FF54473D" Background="{x:Null}" BorderBrush="{x:Null}" Margin="-0.8,-0.8,-0.6,-1.2" Padding="10">
                        <ComboBoxItem Content="مدير إدارة"/>
                        <ComboBoxItem Content="مساعد مدير إدارة"/>
                        <ComboBoxItem Content="رئيس قسم"/>
                        <ComboBoxItem Content="رئيس وحدة"/>
                        <ComboBoxItem Content="موظف"/>

                    </ComboBox>
                </Border>-->
                <!--<TextBlock Width="58" VerticalAlignment="Top" TextWrapping="Wrap" Margin="43,180,0,0" Height="21" HorizontalAlignment="Left" FontFamily="Segoe UI" Foreground="#FF3C3C3C" FontSize="10.667"><Run FlowDirection="RightToLeft" Text="الصفة"/></TextBlock>-->
                <Border BorderBrush="#FFD6D4D4" BorderThickness="1"  Background="White" Height="42" VerticalAlignment="Top" HorizontalAlignment="Left" Width="236" Margin="41,206,0,0">
                    <ComboBox x:Name="cbomangment" TabIndex="6"  HorizontalAlignment="Left" VerticalAlignment="Top" Width="236" Height="42" FontFamily="Segoe UI" FontSize="11.333"
                        ItemsSource="{Binding T_Mangment_Request}"
                        DisplayMemberPath="Mangment_Request"
                        SelectedValuePath="Mangment_Request_ID" Foreground="#FF54473D" Background="{x:Null}" BorderBrush="{x:Null}" Margin="-0.8,-0.8,-1.2,-1.2" Padding="10"/>
                </Border>
