<mah:MetroWindow x:Class="Maintenance_request.Settings.Password_Chanche" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" 
                   BorderThickness="0" BorderBrush="{x:Null}"  dx:ThemeManager.ThemeName="Win11Light" Title="تغيير كلمة المرور" Width="620" Height="537"  WindowStartupLocation="CenterOwner" Background="Transparent" AllowsTransparency="True" WindowStyle="None" ShowTitleBar="False" ShowCloseButton="False" ShowMinButton="False" ShowMaxRestoreButton="False" WindowButtonCommandsOverlayBehavior="Never" Language="ar-LY" FlowDirection="RightToLeft" FontFamily="Segoe UI" FontSize="15">
    <Border Margin="6" Style="{StaticResource Client.Card}" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Background="{StaticResource Client.Header}" CornerRadius="16,16,0,0" Padding="22,0">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="btnCancel_Click" Style="{StaticResource Client.Button}" Background="Transparent"  Width="42" FontSize="25" Padding="0">
                        <Path Width="16" Height="16" Stretch="Uniform" Data="M0,0 L16,16 M16,0 L0,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <TextBlock Text="تغيير كلمة المرور" Foreground="White" FontSize="24" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>
            <StackPanel Grid.Row="1" Margin="32,0,32,0" VerticalAlignment="Center" Height="373">
                <TextBlock FontSize="22" Foreground="{StaticResource Client.Ink}" FontWeight="SemiBold" Margin="0,0,0,24"><Run FlowDirection="RightToLeft" Language="ar-ly" Text="قم بتغيير كلمة مرور الحساب الخاص بك"/></TextBlock>
                <TextBlock Text="كلمة المرور الحالية" Style="{StaticResource Client.Label}"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <icons:PackIconMaterial Kind="LockOutline" Width="20" Height="20" Foreground="{StaticResource Client.Blue}" VerticalAlignment="Center"/>
                    <PasswordBox Grid.Column="1" x:Name="txbPassword" Style="{StaticResource Client.Input}"/>
                </Grid>
                <TextBlock Style="{StaticResource Client.ErrorText}" Tag="{Binding ElementName=txbPassword}"/>
                <TextBlock Text="كلمة المرور الجديدة" Style="{StaticResource Client.Label}" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <icons:PackIconMaterial Kind="LockReset" Width="20" Height="20" Foreground="{StaticResource Client.Blue}" VerticalAlignment="Center"/>
                    <PasswordBox Grid.Column="1" x:Name="txb_new_Password" Style="{StaticResource Client.Input}"/>
                </Grid>
                <TextBlock Style="{StaticResource Client.ErrorText}" Tag="{Binding ElementName=txb_new_Password}"/>
                <TextBlock Text="تأكيد كلمة المرور الجديدة" Style="{StaticResource Client.Label}" Margin="0,18,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <icons:PackIconMaterial Kind="LockCheckOutline" Width="20" Height="20" Foreground="{StaticResource Client.Blue}" VerticalAlignment="Center"/>
                    <PasswordBox Grid.Column="1" x:Name="txb_sh_Password" Style="{StaticResource Client.Input}" KeyUp="Confirmation_KeyUp"/>
                </Grid>
                <TextBlock Style="{StaticResource Client.ErrorText}" Tag="{Binding ElementName=txb_sh_Password}"/>
                <Button x:Name="SaveButton" Click="Insert_Click" Style="{StaticResource Client.Button}" Margin="0,28,0,0">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="ContentSaveOutline" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="حفظ كلمة المرور"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</mah:MetroWindow>