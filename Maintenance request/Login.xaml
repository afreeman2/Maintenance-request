<mah:MetroWindow x:Class="Maintenance_request.Login"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks" 
                 dx:ThemeManager.ThemeName="Win11Light" Icon="/Maintenance request;component/Resources/maintenance-request-bell.ico"
                 Title="الدخول إلى طلبات الصيانة" Width="1080" Height="720" MinWidth="940"
                 
                 MinHeight="640" WindowStartupLocation="CenterScreen" Background="Transparent" 
                 WindowStyle="None" AllowsTransparency="True" ShowTitleBar="False" ShowCloseButton="False"
                 ShowMinButton="False" ShowMaxRestoreButton="False" WindowButtonCommandsOverlayBehavior="Never"
                 Language="ar-LY" FlowDirection="RightToLeft" FontFamily="Segoe UI" BorderBrush="{x:Null}" BorderThickness="0" FontSize="15"
                 Loaded="LogIn_LoadedAsync" ResizeMode="CanResize">
    <!-- يُضبط حجم نافذة الدخول من حوافها دون إظهار مقبض في الزاوية. -->
    <mah:MetroWindow.Resources>
        <!-- درجات زرقاء رمادية من هوية تطبيق الطلبات، والرسم يعكس إرسال الطلب ومتابعته. -->
        <SolidColorBrush x:Key="Client.LoginBrand" Color="#2B4862" />
        <SolidColorBrush x:Key="Client.LoginForm" Color="#F7F9FC" />
    </mah:MetroWindow.Resources>
    <Border Margin="8" CornerRadius="20" BorderBrush="{StaticResource Client.Line}" BorderThickness="1" Background="{StaticResource Client.LoginForm}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.05*"/>
            </Grid.ColumnDefinitions>
            <!-- لوحة تعريف متجهة تحتفظ باتجاه العربية ومعلومات تطبيق طلبات الصيانة. -->
            <Border Background="{StaticResource Client.LoginBrand}" CornerRadius="20,0,0,20" Padding="28" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Viewbox Margin="0,4,0,18" Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="200" IsHitTestVisible="False">
                        <Canvas Width="400" Height="250">
                            <Ellipse Width="242" Height="242" Canvas.Left="75" Canvas.Top="0" Stroke="#427D9DBB" Fill="#124F7FA8" />
                            <Ellipse Width="192" Height="192" Canvas.Left="100" Canvas.Top="25" Stroke="#306A8EAF" />
                            <Path Data="M25,208 C80,202 64,38 176,33 C272,26 284,213 376,177" Stroke="#BDA16F" StrokeThickness="2" StrokeDashArray="4 6" Opacity="0.7" />
                            <Border Canvas.Left="124" Canvas.Top="32" Width="145" Height="176" Background="#F4F7FC" BorderBrush="#9CB6D1" BorderThickness="1" CornerRadius="16" />
                            <Border Canvas.Left="160" Canvas.Top="20" Width="74" Height="24" Background="#C1A16A" CornerRadius="8" />
                            <Path Data="M148,76 H246 M148,102 H246 M148,128 H203 M148,154 H193" Stroke="#ADBED3" StrokeThickness="4" StrokeStartLineCap="Round" />
                            <Border Canvas.Left="227" Canvas.Top="143" Width="70" Height="70" CornerRadius="20" Background="#C1A16A">
                                <icons:PackIconMaterial Kind="WrenchOutline" Width="35" Height="35" Foreground="#213D5A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Canvas.Left="52" Canvas.Top="55" Width="54" Height="54" CornerRadius="16" Background="#EAF0F7">
                                <icons:PackIconMaterial Kind="BellOutline" Width="28" Height="28" Foreground="#536F8C" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Path Data="M40,226 H360 M65,237 H335" Stroke="#718CAA" StrokeThickness="2" />
                            <Ellipse Canvas.Left="24" Canvas.Top="204" Width="7" Height="7" Fill="#C1A16A" />
                            <Ellipse Canvas.Left="371" Canvas.Top="174" Width="7" Height="7" Fill="#C1A16A" />
                        </Canvas>
                    </Viewbox>
                    <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly">
                        <StackPanel Width="400">
                            <!-- البطاقة الفاتحة تظهر تفاصيل شعار الصندوق فوق اللون الأزرق. -->
                            <Image Source="/Resources/ssf Logo.png" Stretch="Uniform" Height="139" Width="167" />
                            <TextBlock Text="صندوق الضمان الاجتماعي" Foreground="#E2C58E" FontSize="19" TextAlignment="Center" />
                            <TextBlock Text="طلبات الصيانة" Foreground="White" FontSize="34" FontWeight="Bold" Margin="0,10,0,10" TextAlignment="Center" />
                            <TextBlock Text="لإرسال طلبات الصيانة والخدمات ومتابعة حالات الطلبات" Foreground="#D9E4F1" TextWrapping="Wrap" TextAlignment="Center" FontSize="16" LineHeight="26" />
                            <Border Background="#31516E" BorderBrush="#51708C" BorderThickness="1" CornerRadius="14" Padding="17" Margin="0,22,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconMaterial Kind="ClipboardTextOutline" Foreground="#E2C58E" Width="21" Height="21" Margin="0,0,12,0" />
                                        <TextBlock Text="أرسل طلب الصيانة" Foreground="White" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <icons:PackIconMaterial Kind="BellRingOutline" Foreground="#E2C58E" Width="21" Height="21" Margin="0,0,12,0" />
                                        <TextBlock Text="تابع إشعارات وحالة الطلب" Foreground="White" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Viewbox>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="42,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button HorizontalAlignment="Left" Click="out_Click"  FontSize="26" Style="{StaticResource Client.Secondary}" Width="44" Padding="0" Margin="430,0,0,0">
                    <Path Width="16" Height="16" Stretch="Uniform" Data="M0,0 L16,16 M16,0 L0,16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock FontSize="30" FontWeight="Bold" Foreground="{StaticResource Client.Ink}"><Run FlowDirection="RightToLeft" Language="ar-ly" Text="تسجيل الدخول"/></TextBlock>
                    <TextBlock Foreground="{StaticResource Client.Muted}" Margin="0,8,0,30"><Run FlowDirection="RightToLeft" Language="ar-ly" Text="ان لم يكن لديك حساب دخول قم بانشاء حساب مستخدم جديد"/></TextBlock>
                    <TextBlock Text="حساب المستخدم" Style="{StaticResource Client.Label}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <icons:PackIconMaterial Kind="AccountOutline" Width="20" Height="20" Foreground="{StaticResource Client.Blue}" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" x:Name="cboUserFullName" Style="{StaticResource Client.Input}" DisplayMemberPath="User_Name"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Client.ErrorText}" Tag="{Binding ElementName=cboUserFullName}"/>
                    <TextBlock Text="كلمة المرور" Style="{StaticResource Client.Label}" Margin="0,24,0,8"/>
                    <Grid IsKeyboardFocusWithinChanged="PasswordArea_FocusChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="42"/>
                        </Grid.ColumnDefinitions>
                        <icons:PackIconMaterial Kind="LockOutline" Width="20" Height="20"  Foreground="{StaticResource Client.Blue}" VerticalAlignment="Center"/>
                        <dxe:PasswordBoxEdit ShowError="False" ShowErrorToolTip="False" ShowPasswordButtonVisibility="None" ShowCapsLockWarningToolTip="False" Grid.Column="1" x:Name="txbPassword" Style="{StaticResource Client.Input}" KeyUp="Password_KeyUp" PreviewKeyUp="Password_PreviewKeyUp" IsKeyboardFocusWithinChanged="Password_FocusChanged" AutomationProperties.Name="كلمة المرور" Grid.ColumnSpan="2" Margin="0,0,3,0"/>
                        <!-- تبديل ظهور كلمة المرور بنقرة، مع اسم يصف الإجراء المتاح. -->
                        <ToggleButton x:Name="PasswordVisibilityButton"
              Grid.Column="2"
              Width="36"
              Height="34"
              Background="Transparent"
              BorderThickness="0"
              FocusVisualStyle="{x:Null}"
              Focusable="False"
              Foreground="{StaticResource Client.Blue}"
              Checked="PasswordVisibility_Changed"
              Unchecked="PasswordVisibility_Changed">

                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">

                                    <Setter Property="ToolTip"
                    Value="إظهار كلمة المرور"/>

                                    <Setter Property="AutomationProperties.Name"
                    Value="إظهار كلمة المرور"/>

                                    <Setter Property="BorderThickness"
                    Value="0"/>

                                    <Setter Property="Background"
                    Value="Transparent"/>

                                    <Setter Property="FocusVisualStyle"
                    Value="{x:Null}"/>

                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent"
                                BorderThickness="0">

                                                    <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>

                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <icons:PackIconMaterial
                        Kind="EyeOutline"
                        Width="19"
                        Height="19"/>
                                        </Setter.Value>
                                    </Setter>

                                    <Style.Triggers>

                                        <DataTrigger
                    Binding="{Binding Password, ElementName=txbPassword}"
                    Value="">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>

                                        <DataTrigger
                    Binding="{Binding Password, ElementName=txbPassword}"
                    Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>

                                        <Trigger Property="IsChecked" Value="True">

                                            <Setter Property="ToolTip"
                            Value="إخفاء كلمة المرور"/>

                                            <Setter Property="AutomationProperties.Name"
                            Value="إخفاء كلمة المرور"/>

                                            <Setter Property="Content">
                                                <Setter.Value>
                                                    <icons:PackIconMaterial
                                Kind="EyeOffOutline"
                                Width="19"
                                Height="19"/>
                                                </Setter.Value>
                                            </Setter>

                                        </Trigger>

                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                        </ToggleButton>
                    </Grid>
                    <TextBlock Style="{StaticResource Client.ErrorText}" Tag="{Binding ElementName=txbPassword}"/>
                    <!-- مساحة ثابتة للتنبيه كي لا يتحرك زر الدخول عند تبديل Caps Lock. -->
                    <TextBlock x:Name="PasswordCapsLockWarning" Text="مفتاح Caps Lock مفعّل" Visibility="Hidden"
                               Height="20" Padding="0,3,0,0" FontSize="12" Foreground="#805008"/>
                    <Button x:Name="BNEXT" Click="BNEXT_Click" Style="{StaticResource Client.Button}" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <icons:PackIconMaterial Kind="Login" Width="22" Height="22" Margin="0,0,10,0"/>
                            <TextBlock Text="دخول"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="LoginStatus" Foreground="{StaticResource Client.Muted}" TextWrapping="Wrap" Margin="0,15,0,0"/>
                </StackPanel>
                <Button Grid.Row="2" Click="Register_Click" Style="{StaticResource Client.Secondary}">
                    <StackPanel Orientation="Horizontal">
                        <icons:PackIconMaterial Kind="AccountPlusOutline" Width="20" Height="20" Margin="0,0,8,0"/>
                        <TextBlock Text="إنشاء حساب مستخدم على هذا الجهاز"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Border>
</mah:MetroWindow>
