<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Maintenance_request</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationIcon>Resources\maintenance-request-bell.ico</ApplicationIcon>
    <ApplicationTitle>منظومة طلب الصيانة</ApplicationTitle>
    <AssemblyTitle>منظومة طلب الصيانة</AssemblyTitle>
    <Product>منظومة طلب الصيانة</Product>
    <ApplicationManifest Condition="'$(InstalledBuild)' != 'true'">app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- مورد أيقونة التطبيق للنوافذ وأيقونة ملف التشغيل. -->
    <Resource Include="Resources\maintenance-request-bell.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\MINICO.ico" />
    <None Remove="Resources\mins4.jpg" />
    <None Remove="Resources\ssf Logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="MINICO.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Wpf.Core" Version="26.1.3" />
    <PackageReference Include="DevExpress.Wpf.Grid.Core" Version="26.1.3" />
    <PackageReference Include="DevExpress.Wpf.Themes.Win11Light" Version="26.1.3" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="MahApps.Metro.IconPacks.BootstrapIcons" Version="6.2.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.BoxIcons" Version="6.2.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.FontAwesome" Version="6.2.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.Ionicons" Version="6.2.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" Version="6.2.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.MaterialDesign" Version="6.2.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.Modern" Version="6.2.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.PicolIcons" Version="6.2.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.SimpleIcons" Version="6.2.1" />
    <PackageReference Include="MahApps.Metro.IconPacks.Zondicons" Version="6.2.1" />
    <PackageReference Include="MahApps.Metro.SimpleChildWindow" Version="2.2.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.6" />
    <PackageReference Include="System.Management" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="data\" />
    <!-- تعريف بروتوكول العمليات مشترك مع منظومة الصيانة لمنع اختلاف ترميز الردود. -->
    <Compile Include="..\..\Maintenance_app\Maintenance_app\dbContext\InstalledConnectionSettings.cs" Link="Support\InstalledConnectionSettings.cs" />
    <Compile Include="..\..\Maintenance_app\Maintenance_app\Requests\RequestProtocol.cs" Link="Notifications\RequestProtocol.cs" />
    <Compile Include="..\..\Maintenance_app\Maintenance_app\Requests\RequestNotificationAppearance.cs" Link="Notifications\RequestNotificationAppearance.cs" />
    <Compile Include="..\..\Maintenance_app\Maintenance_app\Requests\RequestNotificationText.cs" Link="Notifications\RequestNotificationText.cs" />
    <Compile Include="..\..\Maintenance_app\Maintenance_app\Requests\NotificationSound.cs" Link="Notifications\NotificationSound.cs" />
    <EmbeddedResource Include="Resources/ClientNotification1.wav" LogicalName="Maintenance.ClientNotification1.wav" />
    <EmbeddedResource Include="Resources/ClientNotification3.wav" LogicalName="Maintenance.ClientNotification3.wav" />
    <EmbeddedResource Include="..\..\Maintenance_app\Maintenance_app\Resources\RequestNotification.wav" Link="Resources\RequestNotification.wav" LogicalName="Maintenance.RequestNotification.wav" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\MINICO.ico">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\mins4.jpg">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Resources\ssf Logo.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
