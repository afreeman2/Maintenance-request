<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:Maintenance_request.Support">
    <!-- ظ‡ظˆظٹط© طھط·ط¨ظٹظ‚ ط§ظ„ط·ظ„ط¨ط§طھ ظ…ط³طھظ‚ظ„ط©: ط£ط²ط±ظ‚ ط±ظ…ط§ط¯ظٹ ظˆظƒط­ظ„ظٹ ظˆظ„ظ…ط³ط© ط°ظ‡ط¨ظٹط© ط®ظپظٹظپط©. -->
    <SolidColorBrush x:Key="Client.Ink" Color="#233B54"/>
    <SolidColorBrush x:Key="Client.Muted" Color="#667D91"/>
    <SolidColorBrush x:Key="Client.Blue" Color="#536F8C"/>
    <SolidColorBrush x:Key="Client.Tint" Color="#EAF0F7"/>
    <SolidColorBrush x:Key="Client.Line" Color="#D9E2ED"/>
    <SolidColorBrush x:Key="Client.Gold" Color="#BC995F"/>
    <LinearGradientBrush x:Key="Client.Header" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#233B54" Offset="0"/>
        <GradientStop Color="#547391" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Client.Canvas" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FAFBFD" Offset="0"/>
        <GradientStop Color="#EAF0F7" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="Client.Card" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource Client.Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="22"/>
    </Style>
    <Style x:Key="Client.Button" TargetType="Button">
        <Setter Property="MinHeight" Value="42"/>
        <Setter Property="Padding" Value="16,6"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource Client.Blue}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10">
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.68"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="#BC995F"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.42"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Client.Secondary" TargetType="Button" BasedOn="{StaticResource Client.Button}">
        <Setter Property="Background" Value="{StaticResource Client.Tint}"/>
        <Setter Property="Foreground" Value="{StaticResource Client.Ink}"/>
    </Style>
    <Style x:Key="Client.Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Client.Ink}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <ControlTemplate x:Key="Client.Error">
        <Grid>
            <Border BorderBrush="#C62836" BorderThickness="2" CornerRadius="7">
                <AdornedElementPlaceholder/>
            </Border>
            <Border Width="18" Height="18" Background="#C62836" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-6,-6,0,0">
                <TextBlock Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/>
            </Border>
        </Grid>
    </ControlTemplate>
    <Style x:Key="Client.Input" TargetType="Control">
        <Setter Property="s:FieldFeedback.Enabled" Value="True"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="{StaticResource Client.Ink}"/>
        <Setter Property="Background" Value="#F7F9FC"/>
        <Setter Property="BorderBrush" Value="#B8C9DB"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Validation.ErrorTemplate" Value="{StaticResource Client.Error}"/>
        <Style.Triggers>
            <Trigger Property="s:FieldFeedback.HasValue" Value="True">
                <Setter Property="Background" Value="#DFE8F3"/>
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
                <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Client.ErrorText" TargetType="TextBlock">
        <Setter Property="Visibility" Value="Collapsed"/>
        <Setter Property="Foreground" Value="#BD2535"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag.(Validation.HasError), RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
                <Setter Property="Text" Value="{Binding Tag.(Validation.Errors)[0].ErrorContent, RelativeSource={RelativeSource Self}}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <DataTemplate x:Key="Client.FlyoutHeader">
        <Grid Height="0"/>
    </DataTemplate>
</ResourceDictionary>