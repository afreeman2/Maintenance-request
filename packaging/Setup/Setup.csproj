<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MaintenanceRequestSetup</AssemblyName>
    <Product>تثبيت تطبيق طلبات الصيانة</Product>
    <Version>3.0.0</Version>
    <ApplicationIcon>../../Maintenance request/Resources/maintenance-request-bell.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
    <PackageReference Include="DevExpress.Wpf.Core" Version="26.1.3" />
    <PackageReference Include="DevExpress.Wpf.Themes.Win11Light" Version="26.1.3" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Compile Include="../../../Maintenance_app/Maintenance_app/dbContext/InstalledConnectionSettings.cs" Link="InstalledConnectionSettings.cs" />
    <Compile Include="../../../Maintenance_app/packaging/Setup/InstallerShortcuts.cs" Link="InstallerShortcuts.cs" />
    <Compile Include="../../Maintenance request/Support/UiMessages.cs" Link="UiMessages.cs" />
    <EmbeddedResource Include="$(ApplicationPayload)" LogicalName="Application.zip" Condition="'$(ApplicationPayload)' != ''" />
    <Resource Include="../../Maintenance request/Resources/maintenance-request-bell.ico" Link="Application.ico" />
  </ItemGroup>
</Project>
